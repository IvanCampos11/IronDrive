{% extends "base" %}
{% block title %}Spaces – IronDrive{% endblock %}

{% block content %}
<div class="flex items-center gap-3 h-16 pl-6 pr-3 sm:pr-4 sticky top-0 bg-surface z-10 rounded-t-2xl">
  <h1 class="page-title flex-1">Spaces</h1>
  <button type="button" class="btn-tonal" data-dialog-open="create-space-dialog"><span class="ms">add</span>New space</button>
</div>

{% if spaces | length == 0 %}
<div class="flex flex-col items-center justify-center text-center px-6 py-20">
  <div class="w-28 h-28 rounded-full bg-surface-2 flex items-center justify-center mb-6"><span class="ms text-muted" style="font-size:56px">workspaces</span></div>
  <h2 class="text-lg">No spaces yet</h2>
  <p class="mt-1.5 text-muted max-w-sm">Spaces are shared folders. Create one, then give people or groups access to it.</p>
  <button type="button" class="btn-filled mt-6" data-dialog-open="create-space-dialog"><span class="ms">add</span>Create a space</button>
</div>
{% else %}
<div class="px-2 sm:px-4 pb-4">
  <div class="hidden md:grid grid-cols-[minmax(0,1fr)_120px_120px_150px_48px] items-center h-11 px-4 text-[13px] font-medium text-muted border-b border-outline">
    <span>Name</span><span>Your access</span><span>Shared with</span><span>Created</span><span></span>
  </div>
  <ul>
    {% for space in spaces %}
    <li class="relative grid grid-cols-[minmax(0,1fr)_48px] md:grid-cols-[minmax(0,1fr)_120px_120px_150px_48px] items-center h-14 px-4 border-b border-outline/70 hover:bg-fg/[0.04]">
      <a href="/spaces/{{ space.id }}" class="flex items-center gap-3 min-w-0 after:absolute after:inset-0">
        <span class="ms ms-fill text-primary">workspaces</span>
        <span class="truncate font-medium">{{ space.name }}</span>
      </a>
      <span class="hidden md:block">
        <span class="{% if space.user_permission == 'admin' %}chip-primary{% elif space.user_permission == 'write' %}chip-warning{% else %}chip{% endif %}">
          {% if space.user_permission == 'admin' %}Admin{% elif space.user_permission == 'write' %}Can edit{% else %}View only{% endif %}
        </span>
      </span>
      <span class="hidden md:block text-muted text-[13px]">{% if space.grantee_count == 0 %}Only you{% else %}{{ space.grantee_count }} {% if space.grantee_count == 1 %}grant{% else %}grants{% endif %}{% endif %}</span>
      <span class="hidden md:block text-muted text-[13px]"><time datetime="{{ space.created_at }}">{{ space.created_at }}</time></span>
      <span class="relative z-10 flex justify-end">
        {% if space.user_permission == 'admin' %}
        <a href="/spaces/{{ space.id }}/settings" class="icon-btn-sm" title="Space settings" aria-label="Settings for {{ space.name }}"><span class="ms">settings</span></a>
        {% endif %}
      </span>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<dialog id="create-space-dialog" class="dialog max-w-sm" aria-labelledby="create-space-title" data-new-dialog>
  <form method="post" action="/spaces/create">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <h2 id="create-space-title" class="dialog-title">New space</h2>
    <label for="space-name" class="field-label">Name</label>
    <input type="text" id="space-name" name="name" class="field" required maxlength="100" placeholder="e.g. Family photos" autocomplete="off">
    <p class="field-hint">You can share it with people and groups after it's created.</p>
    <div class="dialog-actions">
      <button type="button" class="btn-text" data-close>Cancel</button>
      <button type="submit" class="btn-text">Create</button>
    </div>
  </form>
</dialog>
{% endblock %}
