{% extends "base" %}

{% block title %}Spaces – IronDrive{% endblock %}

{% block content %}
<div class="animate-fade-in">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 tracking-tight">Spaces</h1>
    <button type="button" id="create-space-btn" class="btn-primary text-sm">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      New Space
    </button>
  </div>

  {% include "partials/flash" %}

  {% if spaces | length == 0 %}
  <!-- Empty state -->
  <div class="card text-center py-20 px-6">
    <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 dark:bg-gray-800 rounded-2xl mb-5">
      <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
    </div>
    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">No spaces yet</p>
    <p class="mt-1.5 text-xs text-gray-400 dark:text-gray-500">Create a space to collaborate on files with others</p>
  </div>
  {% else %}
  <!-- Space cards grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {% for space in spaces %}
      {% include "partials/space_card" %}
    {% endfor %}
  </div>
  {% endif %}
</div>

<!-- Create Space modal -->
<div id="create-space-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="create-space-modal-title">
  <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
    <div class="flex items-center gap-3 mb-5">
      <div class="flex items-center justify-center w-9 h-9 bg-purple-50 dark:bg-purple-900/30 rounded-lg">
        <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
      </div>
      <h3 id="create-space-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">New Space</h3>
    </div>
    <form method="post" action="/spaces/create" id="create-space-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="mb-5">
        <label for="space-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Name</label>
        <input
          type="text" name="name" id="space-name" required
          placeholder="e.g. Project Alpha"
          maxlength="100"
          class="input-field"
        >
      </div>
      <div class="flex justify-end gap-3">
        <button type="button" data-modal-close class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-primary">Create Space</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/spaces.js?v=0.3.0" defer></script>
{% endblock %}
