{% extends "base" %}
{% block title %}Settings – {{ space.name }} – IronDrive{% endblock %}

{% block content %}
<div class="flex items-center gap-2 h-16 pl-2 pr-3 sm:pr-4">
  <a href="/spaces/{{ space.id }}" class="icon-btn" aria-label="Back to {{ space.name }}" title="Back to space"><span class="ms">arrow_back</span></a>
  <h1 class="page-title flex-1 truncate">{{ space.name }} <span class="text-muted">· Settings</span></h1>
</div>

<div class="px-4 sm:px-6 pb-8 max-w-4xl space-y-6">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pl-2 text-[13px] text-muted">
    <span class="inline-flex items-center gap-1.5"><span class="ms text-[18px]">badge</span>Your access: {% if user_permission == 'admin' %}Admin{% elif user_permission == 'write' %}Can edit{% else %}View only{% endif %}</span>
    <span class="inline-flex items-center gap-1.5"><span class="ms text-[18px]">schedule</span>Created <time datetime="{{ space.created_at }}" data-full>{{ space.created_at }}</time></span>
  </div>

  {% if is_admin %}
  <section class="section p-5">
    <h2 class="section-title mb-4">Name</h2>
    <form method="post" action="/spaces/{{ space.id }}/settings/rename" class="flex flex-col sm:flex-row gap-3">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="text" name="name" value="{{ space.name }}" required maxlength="100" class="field sm:max-w-sm" aria-label="Space name">
      <button type="submit" class="btn-tonal self-start">Save</button>
    </form>
  </section>
  {% endif %}

  <section class="section">
    <div class="flex items-center gap-3 h-16 pl-5 pr-3">
      <h2 class="section-title flex-1">People and groups with access</h2>
      {% if is_admin %}
      <button type="button" class="btn-tonal" data-dialog-open="grant-access-dialog"><span class="ms">person_add</span>Share</button>
      {% endif %}
    </div>
    <div id="access-list" class="border-t border-outline">
      {% include "partials/access_list" %}
    </div>
  </section>

  {% if is_admin %}
  <section class="section p-5 border-danger/40">
    <h2 class="section-title text-danger">Delete this space</h2>
    <p class="mt-1 mb-4 text-muted">All files in the space are permanently deleted, and everyone loses access. This can't be undone.</p>
    <form method="post" action="/spaces/{{ space.id }}/settings/delete"
          data-confirm="Every file in “{{ space.name }}” will be permanently deleted." data-confirm-title="Delete space?" data-confirm-label="Delete space" data-confirm-danger>
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="btn-danger"><span class="ms">delete</span>Delete space</button>
    </form>
  </section>
  {% endif %}
</div>

{% if is_admin %}
<dialog id="grant-access-dialog" class="dialog overflow-visible" aria-labelledby="grant-access-title">
  <form method="post" action="/spaces/{{ space.id }}/settings/grant" class="space-y-4" data-picker-form>
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="grantee_type" data-picker-value="type">
    <input type="hidden" name="grantee_id" data-picker-value="id">
    <h2 id="grant-access-title" class="dialog-title">Share “{{ space.name }}”</h2>
    {% set picker_types = "user,group" %}
    {% include "partials/picker" %}
    <div>
      <label for="grant-permission" class="field-label">Access</label>
      <select id="grant-permission" name="permission" class="field">
        <option value="read">View only — can see and download files</option>
        <option value="write" selected>Can edit — can also upload, rename, move and delete</option>
        <option value="admin">Admin — can also manage access and settings</option>
      </select>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn-text" data-close>Cancel</button>
      <button type="submit" class="btn-text" data-picker-submit disabled>Share</button>
    </div>
  </form>
</dialog>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/static/js/picker.js?v={{ asset_v() }}" defer></script>
{% endblock %}
