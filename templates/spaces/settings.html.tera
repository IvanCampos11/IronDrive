{% extends "base" %}

{% block title %}{{ space.name }} Settings – IronDrive{% endblock %}

{% block content %}
<div class="animate-fade-in max-w-3xl mx-auto">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3 min-w-0">
      <a href="/spaces/{{ space.id }}" class="p-2 -ml-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Back to space">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      </a>
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 tracking-tight truncate">{{ space.name }}</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Space settings</p>
      </div>
    </div>
  </div>

  <!-- Space info card -->
  <section class="card p-5 mb-6">
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Your Permission</dt>
        <dd>
          <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full
            {% if user_permission == 'admin' %}
              bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300
            {% elif user_permission == 'write' %}
              bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300
            {% else %}
              bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400
            {% endif %}
          ">{{ user_permission }}</span>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Shared With</dt>
        <dd class="font-medium text-gray-900 dark:text-gray-100">{{ space.grantee_count }}</dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Created</dt>
        <dd class="font-medium text-gray-900 dark:text-gray-100">{{ space.created_at }}</dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Space ID</dt>
        <dd class="font-mono text-xs text-gray-500 dark:text-gray-400 truncate" title="{{ space.id }}">{{ space.id }}</dd>
      </div>
    </dl>
  </section>

  {% if is_admin %}
  <!-- Rename section -->
  <section class="card p-5 mb-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Rename Space</h2>
    <form method="post" action="/spaces/{{ space.id }}/settings/rename" id="rename-space-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="flex gap-3">
        <input type="text" name="name" value="{{ space.name }}" required maxlength="100" class="input-field flex-1">
        <button type="submit" class="btn-primary">Save</button>
      </div>
    </form>
  </section>
  {% endif %}

  <!-- Access management section -->
  <section class="card p-5 mb-6">
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 bg-purple-50 dark:bg-purple-900/30 rounded-lg">
          <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Access</h2>
      </div>
      {% if is_admin %}
      <button type="button" id="grant-access-btn" class="btn-primary text-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        Grant Access
      </button>
      {% endif %}
    </div>

    <div id="access-list">
      {% include "partials/access_list" %}
    </div>
  </section>

  {% if is_admin %}
  <!-- Danger zone -->
  <section class="card p-5 border-red-200 dark:border-red-900/50">
    <h2 class="text-lg font-semibold text-red-600 dark:text-red-400 mb-2">Danger Zone</h2>
    <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Deleting a space permanently removes all files, access grants, and data. This cannot be undone.</p>
    <button type="button" id="delete-space-btn" class="btn-danger text-sm">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      Delete Space
    </button>
  </section>

  <!-- Delete Space modal -->
  <div id="delete-space-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="delete-space-modal-title">
    <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex items-center justify-center w-9 h-9 bg-red-50 dark:bg-red-900/30 rounded-lg">
          <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        </div>
        <h3 id="delete-space-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">Delete Space</h3>
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
        Are you sure you want to delete <strong>{{ space.name }}</strong>? All files and access grants will be permanently removed. This action cannot be undone.
      </p>
      <form method="post" action="/spaces/{{ space.id }}/settings/delete" id="delete-space-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="flex justify-end gap-3">
          <button type="button" data-modal-close class="btn-secondary">Cancel</button>
          <button type="submit" class="btn-danger">Delete Space</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Grant Access modal -->
  <div id="grant-access-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="grant-access-modal-title">
    <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
      <div class="flex items-center gap-3 mb-5">
        <div class="flex items-center justify-center w-9 h-9 bg-green-50 dark:bg-green-900/30 rounded-lg">
          <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        </div>
        <h3 id="grant-access-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">Grant Access</h3>
      </div>
      <form method="post" action="/spaces/{{ space.id }}/settings/grant" id="grant-access-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="grantee_type" id="grant-grantee-type" value="">
        <input type="hidden" name="grantee_id" id="grant-grantee-id" value="">
        <div class="mb-4 relative">
          <label for="grant-search" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">User or Group</label>
          <input
            type="text"
            id="grant-search"
            autocomplete="off"
            placeholder="Start typing a username or group name…"
            class="input-field"
          >
          <!-- Selected pill (shown after selection) -->
          <div id="grant-selected" class="hidden mt-2 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300">
            <span id="grant-selected-icon"></span>
            <span id="grant-selected-name"></span>
            <button type="button" id="grant-clear-selection" class="ml-1 text-purple-400 hover:text-purple-600 dark:hover:text-purple-200" aria-label="Clear selection">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <!-- Dropdown -->
          <div id="grant-dropdown" class="hidden absolute left-0 right-0 mt-1 max-h-48 overflow-y-auto rounded-xl border border-gray-200/70 dark:border-gray-700/70 bg-white dark:bg-gray-800 shadow-elevated z-50">
            <ul id="grant-results" class="py-1" role="listbox"></ul>
          </div>
        </div>
        <div class="mb-5">
          <label for="grant-permission" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Permission</label>
          <select name="permission" id="grant-permission" class="input-field">
            <option value="read">Read (view files)</option>
            <option value="write" selected>Write (upload, edit)</option>
            <option value="admin">Admin (manage access)</option>
          </select>
        </div>
        <div class="flex justify-end gap-3">
          <button type="button" data-modal-close class="btn-secondary">Cancel</button>
          <button type="submit" id="grant-submit-btn" class="btn-primary" disabled>Grant Access</button>
        </div>
      </form>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/spaces.js?v=0.5.0" defer></script>
{% endblock %}
