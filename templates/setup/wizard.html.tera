{% extends "auth/shell" %}
{% block title %}Set up – IronDrive{% endblock %}
{% block card %}
<h1 class="text-[28px] leading-9 text-fg">Welcome, {{ user }}</h1>
<p class="mt-2 mb-8 text-muted">One step left: create your personal library.</p>
{% include "partials/form_flash" %}
<ul class="space-y-4 mb-8">
  <li class="flex gap-4">
    <span class="ms ms-lg text-primary">lock</span>
    <div><p class="font-medium">Encrypted at rest</p><p class="text-muted mt-0.5">Every file is encrypted with AES-256-GCM using a key unique to your library.</p></div>
  </li>
  <li class="flex gap-4">
    <span class="ms ms-lg text-primary">shield</span>
    <div><p class="font-medium">Checked for corruption</p><p class="text-muted mt-0.5">Each file carries a checksum, and background scans flag damaged data.</p></div>
  </li>
  <li class="flex gap-4">
    <span class="ms ms-lg text-primary">key</span>
    <div><p class="font-medium">No passphrase to remember</p><p class="text-muted mt-0.5">The server manages the keys, so your files are always available when you sign in.</p></div>
  </li>
</ul>
<form method="post" action="/setup" class="flex justify-end">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <button type="submit" class="btn-filled px-6">Create my library</button>
</form>
{% endblock %}
