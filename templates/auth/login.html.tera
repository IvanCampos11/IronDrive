{% extends "auth/shell" %}
{% block title %}Sign in – IronDrive{% endblock %}
{% block card %}
<h1 class="text-[28px] leading-9 text-fg">Sign in</h1>
<p class="mt-2 mb-8 text-muted">to continue to your files</p>
{% include "partials/form_flash" %}
<form method="post" action="/login" class="space-y-5">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div>
    <label for="username" class="field-label">Username</label>
    <input type="text" id="username" name="username" class="field" required autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
  </div>
  <div>
    <label for="password" class="field-label">Password</label>
    <input type="password" id="password" name="password" class="field" required autocomplete="current-password">
  </div>
  <p class="-mt-2 text-right"><a href="/reset" class="text-[13px] text-primary hover:underline">Have a reset code?</a></p>
  <div class="flex items-center justify-between pt-2">
    <a href="/register" class="btn-text -ml-3">Create account</a>
    <button type="submit" class="btn-filled px-6">Sign in</button>
  </div>
</form>
{% endblock %}
