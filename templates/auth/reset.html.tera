{% extends "auth/shell" %}
{% block title %}Reset password – IronDrive{% endblock %}
{% block card %}
<h1 class="text-[28px] leading-9 text-fg">Reset your password</h1>
<p class="mt-2 mb-8 text-muted">Use the one-time code your administrator gave you. Codes expire after 24 hours.</p>
{% include "partials/form_flash" %}
<form method="post" action="/reset" class="space-y-5">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div>
    <label for="username" class="field-label">Username</label>
    <input type="text" id="username" name="username" class="field" required autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
  </div>
  <div>
    <label for="code" class="field-label">Reset code</label>
    <input type="text" id="code" name="code" class="field font-mono uppercase tracking-wider" required autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX-XXXX-XXXX">
  </div>
  <div>
    <label for="new_password" class="field-label">New password</label>
    <input type="password" id="new_password" name="new_password" class="field" required minlength="8" autocomplete="new-password">
  </div>
  <div>
    <label for="new_password_confirm" class="field-label">Repeat new password</label>
    <input type="password" id="new_password_confirm" name="new_password_confirm" class="field" required minlength="8" autocomplete="new-password" data-match="new_password">
  </div>
  <details class="group">
    <summary class="cursor-pointer text-[13px] text-primary select-none">My administrator said I need a new encryption password too</summary>
    <div class="mt-3">
      <label for="new_encryption_password" class="field-label">New encryption password</label>
      <input type="password" id="new_encryption_password" name="new_encryption_password" class="field" minlength="8" autocomplete="new-password">
      <p class="field-hint">For accounts that use two passwords. Must differ from your login password.</p>
    </div>
  </details>
  <div class="flex items-center justify-between pt-4">
    <a href="/login" class="btn-text -ml-3">Back to sign in</a>
    <button type="submit" class="btn-filled px-6">Reset password</button>
  </div>
</form>
{% endblock %}
