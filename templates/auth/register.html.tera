{% extends "auth/shell" %}
{% block title %}Create account – IronDrive{% endblock %}
{% block card %}
<h1 class="text-[28px] leading-9 text-fg">Create your account</h1>
<p class="mt-2 mb-8 text-muted">Your files are encrypted before they're stored.</p>
{% include "partials/form_flash" %}
<form method="post" action="/register" class="space-y-5">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div>
    <label for="username" class="field-label">Username</label>
    <input type="text" id="username" name="username" class="field" required autocomplete="username" autocapitalize="none" spellcheck="false" autofocus
           minlength="3" maxlength="32" pattern="[A-Za-z0-9][A-Za-z0-9_\-]*" aria-describedby="username-hint">
    <p id="username-hint" class="field-hint">3–32 characters: letters, numbers, - and _</p>
  </div>
  <div>
    <label for="email" class="field-label">Email</label>
    <input type="email" id="email" name="email" class="field" required autocomplete="email">
  </div>
  <div class="grid sm:grid-cols-2 gap-5 sm:gap-3">
    <div>
      <label for="password" class="field-label">Password</label>
      <input type="password" id="password" name="password" class="field" required autocomplete="new-password" minlength="8" maxlength="1024">
    </div>
    <div>
      <label for="password_confirm" class="field-label">Confirm</label>
      <input type="password" id="password_confirm" name="password_confirm" class="field" required autocomplete="new-password" minlength="8" maxlength="1024">
    </div>
  </div>
  <p class="field-hint -mt-3">Use 8 or more characters.</p>
  <div class="flex items-center justify-between pt-4">
    <a href="/login" class="btn-text -ml-3">Sign in instead</a>
    <button type="submit" class="btn-filled px-6">Create account</button>
  </div>
</form>
{% endblock %}
