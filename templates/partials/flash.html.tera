{% if flash_msg is defined and flash_msg %}
<div class="snackbar" role="status" data-auto-dismiss>
  {% if flash_kind is defined and flash_kind == "error" %}<span class="ms text-danger dark:text-[#ffb4ab]">error</span>{% endif %}
  <span class="flex-1 py-1">{{ flash_msg }}</span>
  <button type="button" class="icon-btn-sm" data-dismiss-snackbar aria-label="Dismiss"><span class="ms">close</span></button>
</div>
{% endif %}
