{% if flash_msg is defined and flash_msg %}
<div
  role="alert"
  aria-live="polite"
  data-auto-dismiss="5000"
  class="px-4 py-3 rounded-xl text-sm flex items-start gap-3 shadow-elevated animate-slide-up
    {% if flash_kind is defined and flash_kind == "success" %}
      bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-300 border border-green-200/60 dark:border-green-800/40
    {% elif flash_kind is defined and flash_kind == "error" %}
      bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-300 border border-red-200/60 dark:border-red-800/40
    {% else %}
      bg-blue-50 dark:bg-blue-900/20 text-blue-800 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/40
    {% endif %}
  "
>
  {% if flash_kind is defined and flash_kind == "success" %}
    <svg class="w-5 h-5 flex-shrink-0 text-green-500 dark:text-green-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  {% elif flash_kind is defined and flash_kind == "error" %}
    <svg class="w-5 h-5 flex-shrink-0 text-red-500 dark:text-red-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  {% else %}
    <svg class="w-5 h-5 flex-shrink-0 text-blue-500 dark:text-blue-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  {% endif %}
  <span class="flex-1">{{ flash_msg }}</span>
  <button type="button" data-dismiss-flash class="flex-shrink-0 p-0.5 rounded-lg opacity-60 hover:opacity-100 transition-opacity" aria-label="Dismiss">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
</div>
{% endif %}
