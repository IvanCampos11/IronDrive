<a href="/usage" class="block group">
  <div class="flex items-center justify-between text-xs mb-1.5">
    <span class="text-gray-500 dark:text-gray-400 font-medium">Storage</span>
    <span class="text-gray-600 dark:text-gray-300 font-semibold">{{ disk_bytes_fmt }} <span class="font-normal text-gray-400 dark:text-gray-500">/ {{ quota_bytes_fmt }}</span></span>
  </div>
  <div class="w-full h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
    <div class="h-full rounded-full transition-all duration-300
      {% if usage_pct >= 90 %}bg-red-500{% elif usage_pct >= 70 %}bg-amber-500{% else %}bg-blue-500{% endif %}"
      style="width: {{ usage_pct }}%"></div>
  </div>
</a>
