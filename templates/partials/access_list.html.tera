{# Grants on a space. Context: access_entries, space_id, is_admin, csrf_token #}
{% if access_entries | length == 0 %}
<p class="px-5 py-8 text-center text-muted">Only space admins can see this space right now.{% if is_admin %} Use <strong class="font-medium text-fg">Share</strong> to give others access.{% endif %}</p>
{% else %}
<ul>
  {% for entry in access_entries %}
  <li class="flex items-center gap-3 min-h-[60px] py-2 pl-5 pr-3 border-b border-outline/70 last:border-b-0">
    {% if entry.grantee_type == 'group' %}
    <span class="avatar bg-surface-3 text-fg"><span class="ms">group</span></span>
    {% else %}
    <span class="avatar">{{ entry.grantee_name | truncate(length=1, end="") }}</span>
    {% endif %}
    <div class="flex-1 min-w-0">
      <p class="truncate font-medium">{{ entry.grantee_name }}</p>
      <p class="text-[13px] text-muted">{% if entry.grantee_type == 'group' %}Group{% else %}Person{% endif %} · added <time datetime="{{ entry.granted_at }}">{{ entry.granted_at }}</time></p>
    </div>
    <div class="flex justify-end">
      {% set label = "View only" %}
      {% if entry.permission == 'admin' %}{% set label = "Admin" %}{% elif entry.permission == 'write' %}{% set label = "Can edit" %}{% endif %}
      {% if is_admin %}
      <button type="button" class="btn-text btn-sm text-fg" data-menu-trigger="perm-menu-{{ loop.index }}" aria-haspopup="menu">
        {{ label }}<span class="ms -mr-1">expand_more</span>
      </button>
      <div id="perm-menu-{{ loop.index }}" class="menu" role="menu" hidden>
        {% for perm in ["read", "write", "admin"] %}
        <form method="post" action="/spaces/{{ space_id }}/access/update">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="grantee_type" value="{{ entry.grantee_type }}">
          <input type="hidden" name="grantee_id" value="{{ entry.grantee_id }}">
          <input type="hidden" name="permission" value="{{ perm }}">
          <button type="submit" class="menu-item" role="menuitemradio" aria-checked="{% if perm == entry.permission %}true{% else %}false{% endif %}">
            <span class="ms {% if perm != entry.permission %}invisible{% endif %}">check</span>
            {% if perm == 'admin' %}Admin{% elif perm == 'write' %}Can edit{% else %}View only{% endif %}
          </button>
        </form>
        {% endfor %}
        <div class="menu-sep"></div>
        <form method="post" action="/spaces/{{ space_id }}/access/revoke"
              data-confirm="{{ entry.grantee_name }} will no longer be able to open this space." data-confirm-title="Remove access?" data-confirm-label="Remove" data-confirm-danger>
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="grantee_type" value="{{ entry.grantee_type }}">
          <input type="hidden" name="grantee_id" value="{{ entry.grantee_id }}">
          <button type="submit" class="menu-item-danger" role="menuitem"><span class="ms">person_remove</span>Remove access</button>
        </form>
      </div>
      {% else %}
      <span class="text-[13px] text-muted">{{ label }}</span>
      {% endif %}
    </div>
  </li>
  {% endfor %}
</ul>
{% endif %}
