<!-- Access list partial — swapped via HTMX on grant/revoke -->
{% if access_entries | length == 0 %}
<div class="text-center py-8">
  <p class="text-sm text-gray-500 dark:text-gray-400">No additional access grants.</p>
</div>
{% else %}
<div>
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-200 dark:border-gray-700/50 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
        <th class="pb-3 pr-4">Name</th>
        <th class="pb-3 pr-4">Type</th>
        <th class="pb-3 pr-4">Permission</th>
        <th class="pb-3 pr-4">Granted</th>
        {% if is_admin %}
        <th class="pb-3 text-right">Actions</th>
        {% endif %}
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
      {% for entry in access_entries %}
      <tr class="group/row">
        <td class="py-3 pr-4">
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full flex-shrink-0
              {% if entry.grantee_type == 'group' %}
                bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300
              {% else %}
                bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300
              {% endif %}
              text-xs font-bold uppercase">
              {{ entry.grantee_name | truncate(length=1, end="") }}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">{{ entry.grantee_name }}</p>
            </div>
          </div>
        </td>
        <td class="py-3 pr-4">
          <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full
            {% if entry.grantee_type == 'group' %}
              bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300
            {% else %}
              bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400
            {% endif %}
          ">{{ entry.grantee_type }}</span>
        </td>
        <td class="py-3 pr-4">
          {% if is_admin %}
          <div class="relative inline-block" data-permission-menu>
            <button type="button" class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full cursor-pointer transition-colors
              {% if entry.permission == 'admin' %}
                bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/50
              {% elif entry.permission == 'write' %}
                bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 hover:bg-green-100 dark:hover:bg-green-900/50
              {% else %}
                bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700
              {% endif %}
            " data-permission-trigger>
              {{ entry.permission }}
              <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="hidden absolute left-0 mt-1 w-36 rounded-lg border border-gray-200/70 dark:border-gray-700/70 bg-white dark:bg-gray-800 shadow-elevated z-40 py-1" data-permission-dropdown>
              {% for perm in ["read", "write", "admin"] %}
              {% if perm != entry.permission %}
              <form method="post" action="/spaces/{{ space_id }}/access/update" class="block">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="grantee_type" value="{{ entry.grantee_type }}">
                <input type="hidden" name="grantee_id" value="{{ entry.grantee_id }}">
                <input type="hidden" name="permission" value="{{ perm }}">
                <button type="submit" class="w-full text-left px-3 py-1.5 text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-2">
                  <span class="inline-block w-2 h-2 rounded-full flex-shrink-0
                    {% if perm == 'admin' %}bg-blue-500
                    {% elif perm == 'write' %}bg-green-500
                    {% else %}bg-gray-400{% endif %}
                  "></span>
                  {{ perm }}
                </button>
              </form>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          {% else %}
          <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full
            {% if entry.permission == 'admin' %}
              bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300
            {% elif entry.permission == 'write' %}
              bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300
            {% else %}
              bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400
            {% endif %}
          ">{{ entry.permission }}</span>
          {% endif %}
        </td>
        <td class="py-3 pr-4 text-gray-500 dark:text-gray-400 text-xs whitespace-nowrap">{{ entry.granted_at }}</td>
        {% if is_admin %}
        <td class="py-3 text-right">
          <form method="post" action="/spaces/{{ space_id }}/access/revoke" class="inline" data-confirm-revoke="{{ entry.grantee_name }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="grantee_type" value="{{ entry.grantee_type }}">
            <input type="hidden" name="grantee_id" value="{{ entry.grantee_id }}">
            <button type="submit" class="text-xs text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 font-medium">
              Revoke
            </button>
          </form>
        </td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
