{# Members table for a group. Context: members, group_id, is_owner, is_manager, csrf_token #}
{% if members | length == 0 %}
<p class="px-5 py-8 text-center text-muted">No members yet.</p>
{% else %}
<ul>
  {% for member in members %}
  <li class="flex items-center gap-3 min-h-[60px] py-2 pl-5 pr-3 border-b border-outline/70 last:border-b-0">
    <span class="avatar">{{ member.username | truncate(length=1, end="") }}</span>
    <div class="flex-1 min-w-0">
      <p class="truncate font-medium">{{ member.username }}</p>
      <p class="truncate text-[13px] text-muted">{{ member.email }}</p>
    </div>
    <span class="hidden md:block w-28 text-[13px] text-muted"><time datetime="{{ member.joined_at }}">{{ member.joined_at }}</time></span>
    <div class="w-28 flex justify-end">
      {% if is_owner and member.role != 'owner' %}
      <button type="button" class="btn-text btn-sm text-fg capitalize" data-menu-trigger="role-menu-{{ loop.index }}" aria-haspopup="menu">
        {{ member.role }}<span class="ms -mr-1">expand_more</span>
      </button>
      <div id="role-menu-{{ loop.index }}" class="menu" role="menu" hidden>
        {% for role in ["member", "manager"] %}
        <form method="post" action="/groups/{{ group_id }}/members/{{ member.user_id }}/role">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="role" value="{{ role }}">
          <button type="submit" class="menu-item" role="menuitemradio" aria-checked="{% if role == member.role %}true{% else %}false{% endif %}">
            <span class="ms {% if role != member.role %}invisible{% endif %}">check</span>
            <span class="capitalize">{{ role }}</span>
          </button>
        </form>
        {% endfor %}
      </div>
      {% else %}
      <span class="{% if member.role == 'owner' %}chip-primary{% elif member.role == 'manager' %}chip-warning{% else %}chip{% endif %} capitalize">{{ member.role }}</span>
      {% endif %}
    </div>
    <div class="w-10 flex justify-end">
      {% if (is_owner or is_manager) and member.role != 'owner' %}
      <form method="post" action="/groups/{{ group_id }}/members/{{ member.user_id }}/remove"
            data-confirm="{{ member.username }} will lose access to every space shared with this group." data-confirm-title="Remove {{ member.username }}?" data-confirm-label="Remove" data-confirm-danger>
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button type="submit" class="icon-btn-sm" title="Remove from group" aria-label="Remove {{ member.username }}"><span class="ms">person_remove</span></button>
      </form>
      {% endif %}
    </div>
  </li>
  {% endfor %}
</ul>
{% endif %}
