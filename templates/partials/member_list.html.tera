<!-- Member list partial — swapped via HTMX on add/remove -->
{% if members | length == 0 %}
<div class="text-center py-8">
  <p class="text-sm text-gray-500 dark:text-gray-400">No members yet.</p>
</div>
{% else %}
<div>
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-200 dark:border-gray-700/50 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
        <th class="pb-3 pr-4">User</th>
        <th class="pb-3 pr-4">Role</th>
        <th class="pb-3 pr-4">Joined</th>
        {% if is_owner or is_manager %}
        <th class="pb-3 text-right">Actions</th>
        {% endif %}
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
      {% for member in members %}
      <tr class="group/row">
        <td class="py-3 pr-4">
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-xs font-bold uppercase flex-shrink-0">
              {{ member.username | truncate(length=1, end="") }}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">{{ member.username }}</p>
              <p class="text-xs text-gray-500 dark:text-gray-400 truncate">{{ member.email }}</p>
            </div>
          </div>
        </td>
        <td class="py-3 pr-4">
          {% if is_owner and member.role != 'owner' %}
          <div class="relative inline-block" data-permission-menu>
            <button type="button" class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full cursor-pointer transition-colors
              {% if member.role == 'manager' %}
                bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/50
              {% else %}
                bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700
              {% endif %}
            " data-permission-trigger>
              {{ member.role }}
              <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="hidden absolute left-0 mt-1 w-36 rounded-lg border border-gray-200/70 dark:border-gray-700/70 bg-white dark:bg-gray-800 shadow-elevated z-40 py-1" data-permission-dropdown>
              {% for role in ["member", "manager"] %}
              {% if role != member.role %}
              <form method="post" action="/groups/{{ group_id }}/members/{{ member.user_id }}/role" class="block">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="role" value="{{ role }}">
                <button type="submit" class="w-full text-left px-3 py-1.5 text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-2">
                  <span class="inline-block w-2 h-2 rounded-full flex-shrink-0
                    {% if role == 'manager' %}bg-amber-500
                    {% else %}bg-gray-400{% endif %}
                  "></span>
                  {{ role }}
                </button>
              </form>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          {% else %}
          <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full
            {% if member.role == 'owner' %}
              bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300
            {% elif member.role == 'manager' %}
              bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300
            {% else %}
              bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400
            {% endif %}
          ">{{ member.role }}</span>
          {% endif %}
        </td>
        <td class="py-3 pr-4 text-gray-500 dark:text-gray-400 text-xs whitespace-nowrap">{{ member.joined_at }}</td>
        {% if is_owner or is_manager %}
        <td class="py-3 text-right">
          {% if member.role != 'owner' %}
          <form method="post" action="/groups/{{ group_id }}/members/{{ member.user_id }}/remove" class="inline" data-confirm-remove="{{ member.username }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" class="text-xs text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 font-medium">
              Remove
            </button>
          </form>
          {% endif %}
        </td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
