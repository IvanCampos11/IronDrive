<!-- Confirm modal — shown/hidden via app.js -->
<div id="confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
  <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center justify-center w-9 h-9 bg-red-50 dark:bg-red-900/30 rounded-lg">
        <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
      </div>
      <h3 id="confirm-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">Confirm</h3>
    </div>
    <p id="confirm-message" class="text-sm text-gray-600 dark:text-gray-300 mb-6 leading-relaxed"></p>
    <div class="flex justify-end gap-3">
      <button id="confirm-modal-cancel" type="button" data-modal-close class="btn-secondary">Cancel</button>
      <button id="confirm-action" type="button" class="btn-danger">Delete</button>
    </div>
  </div>
</div>
