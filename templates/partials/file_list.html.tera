{% include "partials/breadcrumb" %}

<!-- Toolbar -->
<div class="flex items-center justify-between gap-3 mb-5">
  <div class="flex items-center gap-2 min-w-0">
    <button
      type="button"
      id="btn-new-folder"
      class="btn-secondary"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      New folder
    </button>

    <!-- Selection actions — shown by app.js when checkboxes are ticked -->
    <div id="selection-toolbar" class="hidden items-center gap-1">
      <div class="w-px h-5 bg-gray-200 dark:bg-gray-700"></div>
      <span id="selection-count" class="text-[11px] font-medium text-gray-500 dark:text-gray-400 whitespace-nowrap">0 selected</span>
      <button type="button" id="bulk-move-btn" class="btn-secondary text-[11px] py-1 px-2" aria-label="Move selected">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16l4 4m0 0l4-4m-4 4V4M3 8l4-4m0 0l4 4M7 4v16m10-8h4"/></svg>
        Move
      </button>
      <button type="button" id="bulk-download-btn" class="btn-secondary text-[11px] py-1 px-2" aria-label="Download selected">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Download
      </button>
      <button type="button" id="bulk-delete-btn" class="btn-danger text-[11px] py-1 px-2" aria-label="Delete selected">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Delete
      </button>
      <button type="button" id="selection-clear-btn" class="p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded-lg transition-colors" aria-label="Clear selection">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Upload area -->
  <div class="flex items-center gap-2">
    <div id="upload-menu" class="relative">
      <button
        type="button"
        id="upload-menu-toggle"
        class="btn-primary"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="upload-menu-items"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        Upload
        <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </button>

      <div
        id="upload-menu-items"
        class="hidden absolute right-0 mt-2 w-44 rounded-xl border border-gray-200/70 dark:border-gray-700/70 bg-white dark:bg-gray-800 shadow-elevated z-40 p-1"
        role="menu"
        aria-labelledby="upload-menu-toggle"
      >
        <label class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer" role="menuitem">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Files
          <input type="file" id="file-upload-input" class="sr-only" multiple>
        </label>
        <label class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer" role="menuitem">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>
          Folder
          <input type="file" id="folder-upload-input" class="sr-only" webkitdirectory directory multiple>
        </label>
      </div>
    </div>
  </div>
</div>

<!-- Drop zone overlay -->
<div
  id="drop-zone"
  class="hidden fixed inset-0 z-30 bg-blue-500/10 dark:bg-blue-400/10 border-4 border-dashed border-blue-500 dark:border-blue-400 rounded-2xl flex items-center justify-center pointer-events-none"
>
  <div class="text-center">
    <svg class="mx-auto w-16 h-16 text-blue-500 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
    <p class="mt-2 text-lg font-medium text-blue-600 dark:text-blue-400">Drop files to upload</p>
  </div>
</div>

<!-- File table -->
{% if entries | length == 0 %}
  {% include "partials/empty_state" %}
{% else %}
<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm" id="file-table">
      <thead>
        <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider bg-gray-50/50 dark:bg-gray-800/50">
          <th class="py-3 pl-3 pr-1 w-8">
            <input type="checkbox" id="select-all-checkbox" class="file-checkbox" aria-label="Select all files">
          </th>
          <th class="py-3 pl-2 pr-4 font-medium cursor-pointer select-none" data-sort="name">
            Name
            <svg class="inline w-3 h-3 ml-0.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          </th>
          <th class="py-3 px-4 font-medium cursor-pointer select-none hidden sm:table-cell" data-sort="size">
            Size
            <svg class="inline w-3 h-3 ml-0.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          </th>
          <th class="py-3 px-4 font-medium cursor-pointer select-none hidden md:table-cell" data-sort="modified">
            Modified
            <svg class="inline w-3 h-3 ml-0.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          </th>
          <th class="py-3 px-2 w-10"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800" id="file-tbody">
        {% for entry in entries %}
        <tr
          class="group hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors"
          data-name="{{ entry.name }}"
          data-size="{{ entry.raw_size }}"
          data-modified="{{ entry.raw_modified }}"
          data-is-dir="{{ entry.is_dir }}"
          data-path="{{ entry.path }}"
        >
          <td class="py-2.5 pl-3 pr-1 w-8">
            <input type="checkbox" class="file-select-cb file-checkbox" data-path="{{ entry.path }}" aria-label="Select {{ entry.name }}">
          </td>
          <td class="py-2.5 pl-2 pr-4">
            <div class="flex items-center gap-3 min-w-0">
              {% include "partials/file_icon" %}
              {% if entry.is_dir %}
                <a
                  href="/files?path={{ entry.path }}"
                  class="truncate text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 font-medium transition-colors"
                  hx-get="/files/partial?path={{ entry.path }}"
                  hx-target="#file-browser-content"
                  hx-swap="innerHTML"
                  hx-push-url="/files?path={{ entry.path }}"
                >{{ entry.name }}</a>
              {% else %}
                <a
                  href="/files/download?path={{ entry.path }}"
                  class="truncate text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >{{ entry.name }}</a>
              {% endif %}
            </div>
          </td>
          <td class="py-2.5 px-4 text-gray-500 dark:text-gray-400 whitespace-nowrap hidden sm:table-cell">
            {% if entry.is_dir %}—{% elif entry.size %}{{ entry.size }}{% else %}—{% endif %}
          </td>
          <td class="py-2.5 px-4 text-gray-500 dark:text-gray-400 whitespace-nowrap hidden md:table-cell">
            {% if entry.modified %}{{ entry.modified }}{% else %}—{% endif %}
          </td>
          <td class="py-2.5 px-2 text-right">
            <div class="relative">
              <button type="button" class="row-actions-btn p-1.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Actions for {{ entry.name }}">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/></svg>
              </button>
              <div class="row-actions-menu hidden absolute right-0 top-full mt-1 w-40 rounded-xl border border-gray-200/70 dark:border-gray-700/70 bg-white dark:bg-gray-800 shadow-elevated z-50 p-1 animate-fade-in">
                {% if not entry.is_dir %}
                <a href="/files/download?path={{ entry.path }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                  <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                  Download
                </a>
                {% endif %}
                <button type="button" class="btn-move flex items-center gap-2.5 w-full px-3 py-2 rounded-lg text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" data-path="{{ entry.path }}" data-name="{{ entry.name }}">
                  <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16l4 4m0 0l4-4m-4 4V4M3 8l4-4m0 0l4 4M7 4v16m10-8h4"/></svg>
                  Move
                </button>
                <button type="button" class="btn-rename flex items-center gap-2.5 w-full px-3 py-2 rounded-lg text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" data-path="{{ entry.path }}" data-name="{{ entry.name }}">
                  <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  Rename
                </button>
                <div class="my-1 border-t border-gray-100 dark:border-gray-700/60"></div>
                <button type="button" class="btn-delete flex items-center gap-2.5 w-full px-3 py-2 rounded-lg text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" data-path="{{ entry.path }}" data-name="{{ entry.name }}">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  Delete
                </button>
              </div>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>


{% endif %}
