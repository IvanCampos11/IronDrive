{% include "partials/breadcrumb" %}

<!-- Toolbar -->
<div class="flex flex-wrap items-center justify-between gap-3 mb-5">
  <div class="flex items-center gap-2">
    <button
      type="button"
      id="btn-new-folder"
      class="btn-secondary"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      New folder
    </button>
  </div>

  <!-- Upload area -->
  <div class="flex items-center gap-2">
    <label class="btn-primary cursor-pointer">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
      Upload
      <input type="file" id="file-upload-input" class="sr-only" multiple>
    </label>
  </div>
</div>

<!-- Drop zone overlay -->
<div
  id="drop-zone"
  class="hidden fixed inset-0 z-30 bg-blue-500/10 dark:bg-blue-400/10 border-4 border-dashed border-blue-500 dark:border-blue-400 rounded-2xl flex items-center justify-center pointer-events-none"
>
  <div class="text-center">
    <svg class="mx-auto w-16 h-16 text-blue-500 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
    <p class="mt-2 text-lg font-medium text-blue-600 dark:text-blue-400">Drop files to upload</p>
  </div>
</div>

<!-- File table -->
{% if entries | length == 0 %}
  {% include "partials/empty_state" %}
{% else %}
<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm" id="file-table">
      <thead>
        <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider bg-gray-50/50 dark:bg-gray-800/50">
          <th class="py-3 pl-3 pr-1 w-8">
            <input type="checkbox" id="select-all-checkbox" class="file-checkbox" aria-label="Select all files">
          </th>
          <th class="py-3 pl-2 pr-4 font-medium cursor-pointer select-none" data-sort="name">
            Name
            <svg class="inline w-3 h-3 ml-0.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          </th>
          <th class="py-3 px-4 font-medium cursor-pointer select-none hidden sm:table-cell" data-sort="size">
            Size
            <svg class="inline w-3 h-3 ml-0.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          </th>
          <th class="py-3 px-4 font-medium cursor-pointer select-none hidden md:table-cell" data-sort="modified">
            Modified
            <svg class="inline w-3 h-3 ml-0.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          </th>
          <th class="py-3 px-4 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800" id="file-tbody">
        {% for entry in entries %}
        <tr
          class="group hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors"
          data-name="{{ entry.name }}"
          data-size="{{ entry.raw_size }}"
          data-modified="{{ entry.raw_modified }}"
          data-is-dir="{{ entry.is_dir }}"
          data-path="{{ entry.path }}"
        >
          <td class="py-2.5 pl-3 pr-1 w-8">
            <input type="checkbox" class="file-select-cb file-checkbox" data-path="{{ entry.path }}" aria-label="Select {{ entry.name }}">
          </td>
          <td class="py-2.5 pl-2 pr-4">
            <div class="flex items-center gap-3 min-w-0">
              {% include "partials/file_icon" %}
              {% if entry.is_dir %}
                <a
                  href="/files?path={{ entry.path }}"
                  class="truncate text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 font-medium transition-colors"
                  hx-get="/files/partial?path={{ entry.path }}"
                  hx-target="#file-browser-content"
                  hx-swap="innerHTML"
                  hx-push-url="/files?path={{ entry.path }}"
                >{{ entry.name }}</a>
              {% else %}
                <a
                  href="/files/download?path={{ entry.path }}"
                  class="truncate text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >{{ entry.name }}</a>
              {% endif %}
            </div>
          </td>
          <td class="py-2.5 px-4 text-gray-500 dark:text-gray-400 whitespace-nowrap hidden sm:table-cell">
            {% if entry.is_dir %}—{% elif entry.size %}{{ entry.size }}{% else %}—{% endif %}
          </td>
          <td class="py-2.5 px-4 text-gray-500 dark:text-gray-400 whitespace-nowrap hidden md:table-cell">
            {% if entry.modified %}{{ entry.modified }}{% else %}—{% endif %}
          </td>
          <td class="py-2.5 px-4 text-right whitespace-nowrap">
            <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
              {% if not entry.is_dir %}
              <a
                href="/files/download?path={{ entry.path }}"
                class="p-1.5 text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                title="Download"
                aria-label="Download {{ entry.name }}"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              </a>
              {% endif %}
              <button
                type="button"
                class="p-1.5 text-gray-400 hover:text-amber-600 dark:hover:text-amber-400 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/30 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 btn-rename"
                title="Rename"
                aria-label="Rename {{ entry.name }}"
                data-path="{{ entry.path }}"
                data-name="{{ entry.name }}"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </button>
              <button
                type="button"
                class="p-1.5 text-gray-400 hover:text-red-600 dark:hover:text-red-400 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 btn-delete"
                title="Delete"
                aria-label="Delete {{ entry.name }}"
                data-path="{{ entry.path }}"
                data-name="{{ entry.name }}"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<!-- Selection toolbar — shown by app.js when checkboxes are ticked -->
<div id="selection-toolbar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 flex items-center gap-3 px-5 py-3 bg-white/95 dark:bg-gray-800/95 backdrop-blur-md border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg">
  <span id="selection-count" class="text-sm font-medium text-gray-700 dark:text-gray-200">0 selected</span>
  <div class="w-px h-5 bg-gray-200 dark:bg-gray-700"></div>
  <button type="button" id="bulk-download-btn" class="btn-secondary text-xs py-1.5 px-3" aria-label="Download selected files">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
    Download
  </button>
  <button type="button" id="bulk-delete-btn" class="btn-danger text-xs py-1.5 px-3" aria-label="Delete selected files">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    Delete
  </button>
  <button type="button" id="selection-clear-btn" class="p-1.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded-lg transition-colors" aria-label="Clear selection">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
</div>
{% endif %}
