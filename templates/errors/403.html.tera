{% extends "base" %}

{% block title %}403 Forbidden – IronDrive{% endblock %}

{% block content %}
<div class="min-h-[60vh] flex items-center justify-center px-4">
  <div class="text-center animate-fade-in">
    <div class="inline-flex items-center justify-center w-16 h-16 bg-red-50 dark:bg-red-900/20 rounded-2xl mb-6">
      <svg class="w-8 h-8 text-red-400 dark:text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
    </div>
    <p class="text-7xl font-bold text-gray-200 dark:text-gray-700 tracking-tight">403</p>
    <h1 class="mt-4 text-xl font-semibold text-gray-900 dark:text-gray-100">Access denied</h1>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 max-w-sm mx-auto">You don’t have permission to access this resource.</p>
    <a href="/" class="btn-secondary inline-flex mt-6 text-sm">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Go home
    </a>
  </div>
</div>
{% endblock %}
