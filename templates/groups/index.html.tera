{% extends "base" %}
{% block title %}Groups – IronDrive{% endblock %}

{% block content %}
<div class="flex items-center gap-3 h-16 pl-6 pr-3 sm:pr-4 sticky top-0 bg-surface z-10 rounded-t-2xl">
  <h1 class="page-title flex-1">Groups</h1>
  <button type="button" class="btn-tonal" data-dialog-open="create-group-dialog"><span class="ms">group_add</span>New group</button>
</div>

{% if groups | length == 0 %}
<div class="flex flex-col items-center justify-center text-center px-6 py-20">
  <div class="w-28 h-28 rounded-full bg-surface-2 flex items-center justify-center mb-6"><span class="ms text-muted" style="font-size:56px">groups</span></div>
  <h2 class="text-lg">No groups yet</h2>
  <p class="mt-1.5 text-muted max-w-sm">Groups let you share a space with several people at once.</p>
  <button type="button" class="btn-filled mt-6" data-dialog-open="create-group-dialog"><span class="ms">group_add</span>Create a group</button>
</div>
{% else %}
<div class="px-2 sm:px-4 pb-4">
  <div class="hidden md:grid grid-cols-[minmax(0,1fr)_120px_120px_150px] items-center h-11 px-4 text-[13px] font-medium text-muted border-b border-outline">
    <span>Name</span><span>Your role</span><span>Members</span><span>Created</span>
  </div>
  <ul>
    {% for group in groups %}
    <li class="relative grid grid-cols-[minmax(0,1fr)] md:grid-cols-[minmax(0,1fr)_120px_120px_150px] items-center min-h-[56px] py-2 px-4 border-b border-outline/70 hover:bg-fg/[0.04]">
      <a href="/groups/{{ group.id }}" class="flex items-center gap-3 min-w-0 after:absolute after:inset-0">
        <span class="avatar bg-surface-3 text-fg">{{ group.name | truncate(length=1, end="") }}</span>
        <span class="min-w-0">
          <span class="block truncate font-medium">{{ group.name }}</span>
          {% if group.description %}<span class="block truncate text-[13px] text-muted">{{ group.description }}</span>{% endif %}
        </span>
      </a>
      <span class="hidden md:block"><span class="{% if group.user_role == 'owner' %}chip-primary{% elif group.user_role == 'manager' %}chip-warning{% else %}chip{% endif %} capitalize">{{ group.user_role }}</span></span>
      <span class="hidden md:block text-muted text-[13px]">{{ group.member_count }} {% if group.member_count == 1 %}member{% else %}members{% endif %}</span>
      <span class="hidden md:block text-muted text-[13px]"><time datetime="{{ group.created_at }}">{{ group.created_at }}</time></span>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<dialog id="create-group-dialog" class="dialog" aria-labelledby="create-group-title" data-new-dialog>
  <form method="post" action="/groups/create" class="space-y-4">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <h2 id="create-group-title" class="dialog-title">New group</h2>
    <div>
      <label for="group-name" class="field-label">Name</label>
      <input type="text" id="group-name" name="name" class="field" required maxlength="100" placeholder="e.g. Family" autocomplete="off">
    </div>
    <div>
      <label for="group-description" class="field-label">Description <span class="font-normal text-subtle">(optional)</span></label>
      <textarea id="group-description" name="description" class="field" rows="3" maxlength="500"></textarea>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn-text" data-close>Cancel</button>
      <button type="submit" class="btn-text">Create</button>
    </div>
  </form>
</dialog>
{% endblock %}
