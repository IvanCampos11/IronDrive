{% extends "base" %}

{% block title %}{{ group.name }} – IronDrive{% endblock %}

{% block content %}
<div class="animate-fade-in">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3 min-w-0">
      <a href="/groups" class="p-2 -ml-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Back to groups">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      </a>
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 tracking-tight truncate">{{ group.name }}</h1>
        {% if group.description %}
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5 truncate">{{ group.description }}</p>
        {% endif %}
      </div>
    </div>
    {% if is_owner or is_manager %}
    <div class="flex items-center gap-2 flex-shrink-0">
      <button type="button" id="edit-group-btn" class="btn-secondary text-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Edit
      </button>
      {% if is_owner %}
      <button type="button" id="delete-group-btn" class="btn-danger text-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Delete
      </button>
      {% endif %}
    </div>
    {% endif %}
  </div>

  <!-- Group info card -->
  <section class="card p-5 mb-6">
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Your Role</dt>
        <dd>
          <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full
            {% if user_role == 'owner' %}
              bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300
            {% elif user_role == 'manager' %}
              bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300
            {% else %}
              bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400
            {% endif %}
          ">{{ user_role }}</span>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Members</dt>
        <dd class="font-medium text-gray-900 dark:text-gray-100">{{ member_count }}</dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Created</dt>
        <dd class="font-medium text-gray-900 dark:text-gray-100">{{ group.created_at }}</dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 dark:text-gray-400 mb-1">Group ID</dt>
        <dd class="font-mono text-xs text-gray-500 dark:text-gray-400 truncate" title="{{ group.id }}">{{ group.id }}</dd>
      </div>
    </dl>
  </section>

  <!-- Members section -->
  <section class="card p-5">
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 bg-blue-50 dark:bg-blue-900/30 rounded-lg">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Members</h2>
      </div>
      {% if is_owner or is_manager %}
      <button type="button" id="add-member-btn" class="btn-primary text-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        Add Member
      </button>
      {% endif %}
    </div>

    <div id="member-list">
      {% include "partials/member_list" %}
    </div>
  </section>
</div>

<!-- Edit Group modal -->
{% if is_owner or is_manager %}
<div id="edit-group-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="edit-group-modal-title">
  <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
    <div class="flex items-center gap-3 mb-5">
      <div class="flex items-center justify-center w-9 h-9 bg-amber-50 dark:bg-amber-900/30 rounded-lg">
        <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </div>
      <h3 id="edit-group-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">Edit Group</h3>
    </div>
    <form method="post" action="/groups/{{ group.id }}/edit" id="edit-group-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="mb-4">
        <label for="edit-group-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Name</label>
        <input type="text" name="name" id="edit-group-name" required maxlength="100" value="{{ group.name }}" class="input-field">
      </div>
      <div class="mb-5">
        <label for="edit-group-description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Description <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea name="description" id="edit-group-description" maxlength="500" rows="3" class="input-field resize-none">{% if group.description %}{{ group.description }}{% endif %}</textarea>
      </div>
      <div class="flex justify-end gap-3">
        <button type="button" data-modal-close class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>
{% endif %}

<!-- Delete Group modal -->
{% if is_owner %}
<div id="delete-group-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="delete-group-modal-title">
  <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center justify-center w-9 h-9 bg-red-50 dark:bg-red-900/30 rounded-lg">
        <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
      </div>
      <h3 id="delete-group-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">Delete Group</h3>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
      Are you sure you want to delete <strong>{{ group.name }}</strong>? This will remove all members. This action cannot be undone.
    </p>
    <form method="post" action="/groups/{{ group.id }}/delete" id="delete-group-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="flex justify-end gap-3">
        <button type="button" data-modal-close class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-danger">Delete Group</button>
      </div>
    </form>
  </div>
</div>
{% endif %}

<!-- Add Member modal -->
{% if is_owner or is_manager %}
<div id="add-member-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="add-member-modal-title">
  <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
    <div class="flex items-center gap-3 mb-5">
      <div class="flex items-center justify-center w-9 h-9 bg-green-50 dark:bg-green-900/30 rounded-lg">
        <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      </div>
      <h3 id="add-member-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">Add Member</h3>
    </div>
    <form method="post" action="/groups/{{ group.id }}/members/add" id="add-member-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="username" id="member-username-hidden" value="">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">User</label>
        <!-- Selected user pill (hidden until selection) -->
        <div id="member-selected-pill" class="hidden flex items-center gap-2 px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50">
          <div class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-xs font-bold uppercase flex-shrink-0" id="member-pill-avatar"></div>
          <span class="text-sm font-medium text-gray-900 dark:text-gray-100 flex-1" id="member-pill-name"></span>
          <button type="button" id="member-clear-selection" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 p-0.5 rounded transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <!-- Search input (hidden after selection) -->
        <div id="member-search-wrapper" class="relative">
          <input type="text" id="member-search-input" autocomplete="off" placeholder="Search by username…" class="input-field">
          <div id="member-search-dropdown" class="hidden absolute left-0 right-0 mt-1 rounded-lg border border-gray-200/70 dark:border-gray-700/70 bg-white dark:bg-gray-800 shadow-elevated z-50 max-h-48 overflow-y-auto"></div>
        </div>
      </div>
      <div class="mb-5">
        <label for="member-role" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Role</label>
        <select name="role" id="member-role" class="input-field">
          <option value="member" selected>Member</option>
          <option value="manager">Manager</option>
        </select>
      </div>
      <div class="flex justify-end gap-3">
        <button type="button" data-modal-close class="btn-secondary">Cancel</button>
        <button type="submit" id="add-member-submit" class="btn-primary" disabled>Add Member</button>
      </div>
    </form>
  </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/static/js/group_detail.js?v=0.5.0" defer></script>
{% endblock %}
