{% extends "base" %}
{% block title %}{{ group.name }} – Groups – IronDrive{% endblock %}

{% block content %}
<div class="flex items-center gap-2 h-16 pl-2 pr-3 sm:pr-4">
  <a href="/groups" class="icon-btn" aria-label="Back to groups" title="Back to groups"><span class="ms">arrow_back</span></a>
  <h1 class="page-title flex-1 truncate">{{ group.name }}</h1>
  {% if is_owner or is_manager %}
  <button type="button" class="btn-outline hidden sm:inline-flex" data-dialog-open="edit-group-dialog"><span class="ms">edit</span>Edit</button>
  <button type="button" class="icon-btn sm:hidden" data-dialog-open="edit-group-dialog" aria-label="Edit group"><span class="ms">edit</span></button>
  {% endif %}
  {% if is_owner %}
  <form method="post" action="/groups/{{ group.id }}/delete" data-confirm="“{{ group.name }}” and all of its memberships will be deleted. Spaces shared with it lose that access." data-confirm-title="Delete group?" data-confirm-label="Delete" data-confirm-danger>
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button type="submit" class="icon-btn" aria-label="Delete group" title="Delete group"><span class="ms">delete</span></button>
  </form>
  {% endif %}
</div>

<div class="px-4 sm:px-6 pb-8 max-w-4xl">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pl-2 mb-8 text-[13px] text-muted">
    {% if group.description %}<p class="w-full text-sm text-fg">{{ group.description }}</p>{% endif %}
    <span class="inline-flex items-center gap-1.5"><span class="ms text-[18px]">badge</span>You're {% if user_role == 'owner' %}the owner{% else %}a {{ user_role }}{% endif %}</span>
    <span class="inline-flex items-center gap-1.5"><span class="ms text-[18px]">schedule</span>Created <time datetime="{{ group.created_at }}" data-full>{{ group.created_at }}</time></span>
  </div>

  <section class="section">
    <div class="flex items-center gap-3 h-16 pl-5 pr-3">
      <h2 class="section-title flex-1">Members <span class="text-muted font-normal">· {{ member_count }}</span></h2>
      {% if is_owner or is_manager %}
      <button type="button" class="btn-tonal" data-dialog-open="add-member-dialog"><span class="ms">person_add</span>Add member</button>
      {% endif %}
    </div>
    <div id="member-list" class="border-t border-outline">
      {% include "partials/member_list" %}
    </div>
  </section>
</div>

{% if is_owner or is_manager %}
<dialog id="edit-group-dialog" class="dialog" aria-labelledby="edit-group-title">
  <form method="post" action="/groups/{{ group.id }}/edit" class="space-y-4">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <h2 id="edit-group-title" class="dialog-title">Edit group</h2>
    <div>
      <label for="edit-group-name" class="field-label">Name</label>
      <input type="text" id="edit-group-name" name="name" class="field" required maxlength="100" value="{{ group.name }}">
    </div>
    <div>
      <label for="edit-group-description" class="field-label">Description <span class="font-normal text-subtle">(optional)</span></label>
      <textarea id="edit-group-description" name="description" class="field" rows="3" maxlength="500">{% if group.description %}{{ group.description }}{% endif %}</textarea>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn-text" data-close>Cancel</button>
      <button type="submit" class="btn-text">Save</button>
    </div>
  </form>
</dialog>

<dialog id="add-member-dialog" class="dialog overflow-visible" aria-labelledby="add-member-title">
  <form method="post" action="/groups/{{ group.id }}/members/add" class="space-y-4" data-picker-form>
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="username" data-picker-value="name">
    <h2 id="add-member-title" class="dialog-title">Add member</h2>
    {% include "partials/picker" %}
    <div>
      <label for="member-role" class="field-label">Role</label>
      <select id="member-role" name="role" class="field">
        <option value="member" selected>Member — can use spaces shared with the group</option>
        <option value="manager">Manager — can also add and remove members</option>
      </select>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn-text" data-close>Cancel</button>
      <button type="submit" class="btn-text" data-picker-submit disabled>Add</button>
    </div>
  </form>
</dialog>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/static/js/picker.js?v={{ asset_v() }}" defer></script>
{% endblock %}
