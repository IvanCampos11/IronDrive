{% extends "base" %}
{% block title %}IronDrive — Files{% endblock %}

{% block content %}
<div id="file-browser-content" class="animate-fade-in">
  {% include "partials/file_list" %}
</div>

{% include "partials/confirm_modal" %}
{% include "partials/upload_panel" %}

<!-- Mkdir modal -->
<div id="mkdir-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="mkdir-modal-title">
  <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
    <div class="flex items-center gap-3 mb-5">
      <div class="flex items-center justify-center w-9 h-9 bg-blue-50 dark:bg-blue-900/30 rounded-lg">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
      </div>
      <h3 id="mkdir-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">New folder</h3>
    </div>
    <form method="post" action="/files/mkdir" id="mkdir-form">
      <input type="hidden" name="path" value="{{ path }}">
      <input
        type="text" name="name" id="mkdir-name" required autofocus
        placeholder="Folder name"
        class="input-field mb-5"
      >
      <div class="flex justify-end gap-3">
        <button type="button" id="mkdir-cancel" data-modal-close class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-primary">Create</button>
      </div>
    </form>
  </div>
</div>

<!-- Rename modal -->
<div id="rename-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="rename-modal-title">
  <div class="card max-w-sm w-full mx-4 p-6 shadow-modal">
    <div class="flex items-center gap-3 mb-5">
      <div class="flex items-center justify-center w-9 h-9 bg-amber-50 dark:bg-amber-900/30 rounded-lg">
        <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </div>
      <h3 id="rename-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">Rename</h3>
    </div>
    <form method="post" action="/files/rename" id="rename-form">
      <input type="hidden" name="old_path" id="rename-old-path">
      <input
        type="text" name="new_name" id="rename-new-name" required
        placeholder="New name"
        class="input-field mb-5"
      >
      <div class="flex justify-end gap-3">
        <button type="button" id="rename-cancel" data-modal-close class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-primary">Rename</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/upload.js" defer></script>
{% endblock %}
