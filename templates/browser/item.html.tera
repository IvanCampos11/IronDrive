<div class="item" role="row" tabindex="-1" aria-selected="false" {% if can_write %}draggable="true"{% endif %}
     data-path="{{ entry.path }}" data-name="{{ entry.name }}" data-is-dir="{{ entry.is_dir }}"
     data-size="{{ entry.raw_size }}" data-modified="{{ entry.raw_modified }}">
  <span class="item-check"><input type="checkbox" class="check" tabindex="-1" aria-label="Select {{ entry.name }}"></span>
  <div class="item-preview" aria-hidden="true"><span class="ms kind-{{ entry.icon }}">{{ entry.glyph }}</span></div>
  <div class="item-main">
    <span class="ms item-icon kind-{{ entry.icon }} {% if entry.is_dir %}ms-fill{% endif %}" aria-hidden="true">{{ entry.glyph }}</span>
    <div class="min-w-0 flex flex-col">
      <div class="flex items-center gap-1.5 min-w-0">
      {% if entry.is_dir %}
      <a class="item-name" href="{{ base_url }}?path={{ entry.path | urlencode }}" tabindex="-1"
         hx-get="{{ base_url }}/partial?path={{ entry.path | urlencode }}" hx-target="#file-browser-content"
         hx-push-url="{{ base_url }}?path={{ entry.path | urlencode }}">{{ entry.name }}</a>
      {% else %}
      <a class="item-name" href="{{ base_url }}/download?path={{ entry.path | urlencode }}" tabindex="-1" data-download>{{ entry.name }}</a>
      {% endif %}
      {% if entry.problem == "file" %}<span class="item-flag" title="This file is damaged — see Alerts"><span class="ms ms-fill text-danger text-[18px]">error</span><span class="sr-only">Damaged file</span></span>
      {% elif entry.problem == "inside" %}<span class="item-flag" title="Contains a damaged file"><span class="ms text-warning text-[18px]">warning</span><span class="sr-only">Contains a damaged file</span></span>{% endif %}
      </div>
      <span class="item-sub text-xs text-muted truncate">{% if entry.raw_modified %}<time datetime="{{ entry.raw_modified }}">{{ entry.modified }}</time>{% endif %}{% if not entry.is_dir and entry.size %} · {{ entry.size }}{% endif %}</span>
    </div>
  </div>
  <span class="item-meta col-meta">{% if entry.raw_modified %}<time datetime="{{ entry.raw_modified }}">{{ entry.modified }}</time>{% else %}—{% endif %}</span>
  <span class="item-meta col-meta">{% if entry.is_dir %}—{% else %}{{ entry.size | default(value="—") }}{% endif %}</span>
  <div class="item-actions">
    {% if not entry.is_dir %}<button type="button" class="icon-btn-sm item-quick" tabindex="-1" data-item-action="download" title="Download" aria-label="Download {{ entry.name }}"><span class="ms">download</span></button>{% endif %}
    {% if can_write %}<button type="button" class="icon-btn-sm item-quick" tabindex="-1" data-item-action="rename" title="Rename" aria-label="Rename {{ entry.name }}"><span class="ms">edit</span></button>{% endif %}
    <button type="button" class="icon-btn-sm" tabindex="-1" data-item-action="menu" title="More actions" aria-label="More actions for {{ entry.name }}"><span class="ms">more_vert</span></button>
  </div>
</div>
