# IronDrive Configuration
#
# Copy this file to .env and fill in the values.
# The .env file is gitignored and should NEVER be committed.

# ── Secret Key (REQUIRED) ─────────────────────────────────────────────
#
# CRITICAL: This key encrypts the master encryption key in the database.
# If you lose this key, ALL server-mode data and failsafe recovery blobs
# become permanently inaccessible. BACK THIS UP SECURELY.
#
# Generate with: openssl rand -base64 44
IRONDRIVE_SECRET_KEY=CHANGE-ME-generate-a-random-256-bit-key-here

# ── Docker Compose Runtime (optional, recommended for VPS/SSHFS) ─────
#
# Container user/group. Set these to your host account uid/gid so writes
# to mounted storage (including SSHFS) do not fail with permission errors.
# Example: id -u ; id -g
PUID=1000
PGID=1000

# Host storage paths for Docker bind mounts.
#
# Leave commented to use Docker named volumes, or set absolute paths to use
# host directories (recommended on VPS with external mounts).
#IRONDRIVE_DATA_HOST_PATH=/home/cloud-storage/irondrive/data
#IRONDRIVE_DB_HOST_PATH=/var/lib/irondrive/db

# Optional image tag override.
#IRONDRIVE_IMAGE_TAG=dev

# ── Data Directory ────────────────────────────────────────────────────
#
# Where uploaded files are stored (libraries, spaces, chunks).
IRONDRIVE_DATA_DIR=./data

# ── Database Directory ────────────────────────────────────────────────
#
# Where the SQLite database is stored (separate from file storage).
IRONDRIVE_DB_DIR=./db

# ── User Defaults ─────────────────────────────────────────────────────
#
# Size values accept human-friendly formats: "5 GB", "500 MB", "8 MiB", etc.

# Default quota for new users (default 5 GB)
IRONDRIVE_DEFAULT_QUOTA=5 GB

# Maximum single file upload size (default 5 GB)
IRONDRIVE_MAX_UPLOAD=5 GB

# ── Sessions ──────────────────────────────────────────────────────────
#
# Session expiry (in hours, default 7 days)
IRONDRIVE_SESSION_EXPIRY_HOURS=168

# ── Chunked Transfers ────────────────────────────────────────────────
#
# Default chunk size for chunked uploads/downloads (default 8 MiB)
IRONDRIVE_CHUNK_SIZE=8 MiB

# Incomplete chunked uploads are cleaned up after this many hours (default 24h)
IRONDRIVE_CHUNK_UPLOAD_EXPIRY_HOURS=24

# Suggested max parallel chunks per session
IRONDRIVE_MAX_PARALLEL_CHUNKS=4

# ── Background Services ──────────────────────────────────────────────
#
# Enable periodic integrity scanning
IRONDRIVE_INTEGRITY_SCAN_ENABLED=true

# Integrity scan interval (in hours, default: weekly)
IRONDRIVE_INTEGRITY_SCAN_INTERVAL_HOURS=168
